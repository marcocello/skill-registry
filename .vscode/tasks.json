{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compose:up",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "deployment/prod/compose.yaml",
        "up",
        "--build",
        "--watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "compose:logs",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "deployment/prod/compose.yaml",
        "logs",
        "--follow",
        "--tail",
        "100"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "compose:down",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "deployment/prod/compose.yaml",
        "down"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
